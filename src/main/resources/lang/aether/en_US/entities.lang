#Passive

aether.entity.phyg=Phyg
guidebook.section.mob.phyg.name=Phyg
guidebook.section.mob.phyg.desc=Phygs are a common but valuable source of food, feathers and transportation. They can be found anywhere in the aether.

aether.entity.sheepuff=Sheepuff
guidebook.section.mob.sheepuff.name=Sheepuff
guidebook.section.mob.sheepuff.desc=Sheepuff provide lots of wool, and are more fluffy and bouncy. They can be found anywhere in the aether.

aether.entity.phow=Phow
guidebook.section.mob.phow.name=Phow
guidebook.section.mob.phow.desc=Phows are a useful source of leather, feathers and transportation. They can be found anywhere in the aether.

aether.entity.aerbunny=Aerbunny
aether.entity.aerbunny.death_message = ...how did this even happen?
guidebook.section.mob.aerbunny.name=Aerbunny
guidebook.section.mob.aerbunny.desc=A cute and handy source of string, they can be picked up and worn on your head for extra jumps. They can be found anywhere in the aether.

aether.entity.moa_blue=Blue Moa
guidebook.section.mob.moa.blue.name=Blue Moa
guidebook.section.mob.moa.blue.desc=Gentle and docile avian that can be saddled and ridden. Blue variants have 3 midair jumps.

aether.entity.moa_white=White Moa
guidebook.section.mob.moa.white.name=White Moa
guidebook.section.mob.moa.white.desc=Gentle and docile avian that can be saddled and ridden. White variants have 5 midair jumps.

aether.entity.moa_black=Black Moa
guidebook.section.mob.moa.black.name=Black Moa
guidebook.section.mob.moa.black.desc=Gentle and docile avian that can be saddled and ridden. Black variants have 7 midair jumps.

aether.entity.aerwhale=Aerwhale
guidebook.section.mob.aerwhale.name=Aerwhale
guidebook.section.mob.aerwhale.desc=Aerwhales are ancient and peaceful creatures known for drifting through the skies.

#Hostile

aether.entity.swet=Blue Swet
aether.entity.swet.death_message = [PLAYER] became Jell-O.
guidebook.section.mob.swet.name=Blue Swet
guidebook.section.mob.swet.desc=Blue swets can be dangerous if they manage to grab you. They can be found uncommonly anywhere in the aether.

aether.entity.swet_gold=Gold Swet
aether.entity.swet_gold.death_message = [PLAYER] has died to cuteness.
guidebook.section.mob.swet.gold.name=Gold Swet
guidebook.section.mob.swet.gold.desc=Gold swets can be tricky to deal with if you let them pick you up. They can be found rarely anywhere in the aether.

aether.entity.cockatrice=Cockatrice
aether.entity.cockatrice.death_message = [PLAYER] was breathed on to hard.
guidebook.section.mob.cockatrice.name=Cockatrice
guidebook.section.mob.cockatrice.desc=Angry and hostile avian that can be found in dark places. They shoot poison needles out of their mouths.

aether.entity.aechorplant=Aechor Plant
aether.entity.aechorplant.death_message = [PLAYER] has sniffed a flower to hard
guidebook.section.mob.aechorplant.name=Aechor Plant
guidebook.section.mob.aechorplant.desc=Aechor plants are a unique fauna that appear commonly in the aether. They shoot poison needles to deter anything from coming near.

aether.entity.zephyr=Zephyr
guidebook.section.mob.zephyr.name=Zephyr
guidebook.section.mob.zephyr.desc=Common annoyance found floating all over the aether, they shoot snowballs that send you flying.

aether.entity.whirly=Whirly
guidebook.section.mob.whirly.name=Whirly
guidebook.section.mob.whirly.desc=Uncommon mob found in the aether, it throws out items but can become angry.

aether.entity.mimic=Mimic
aether.entity.mimic.death_message = [PLAYER] was chomped to death.
guidebook.section.mob.mimic.name=Mimic
guidebook.section.mob.mimic.desc=A iconic trap for travelers to fall for, found in silver dungeons mixed in with normal chests.

aether.entity.sentry=Sentry
aether.entity.sentry.death_message = [PLAYER] has tripped over pebble.
guidebook.section.mob.sentry.name=Sentry
guidebook.section.mob.sentry.desc=Automatons buried in the floors of bronze dungeons, they spring out when walked on.

aether.entity.valkyrie=Valkyrie
aether.entity.valkyrie.death_message = [PLAYER] lost a honorable duel.
guidebook.section.mob.valkyrie.name=Valkyrie
guidebook.section.mob.valkyrie.desc=A beautiful soldier that can teleport around you, found roaming in silver dungeons.

aether.entity.minion_fire=Fire Minion
aether.entity.minion_fire.death_message = [PLAYER] had hugged fire.
guidebook.section.mob.fireminion.name=Fire Minion
guidebook.section.mob.fireminion.desc=A manifestation summoned from the sun spirit, quick and deadly.

